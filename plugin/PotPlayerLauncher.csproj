<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.PotPlayerLauncher</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.PotPlayerLauncher</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <VersionPrefix>1.1.0</VersionPrefix>
  </PropertyGroup>

  <!--
    Jellyfin 程序集 / NuGet 包引用, 以及 JellyfinDir、EnableJellyfinDlls、包版本
    都集中在同目录的 Directory.Build.props。
  -->

  <!-- 测试工程有自己的 csproj, 不要被插件的默认通配符一起编译 -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

</Project>
