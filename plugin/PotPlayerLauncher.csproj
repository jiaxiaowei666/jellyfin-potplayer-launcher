<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.PotPlayerLauncher</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.PotPlayerLauncher</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <VersionPrefix>1.0.0</VersionPrefix>
  </PropertyGroup>

  <!-- Jellyfin 程序集引用与 JellyfinDir/EnableJellyfinDlls 见同目录 Directory.Build.props -->

  <ItemGroup Condition="'$(EnableJellyfinDlls)' == 'true'">
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
  </ItemGroup>

  <!-- 测试工程有自己的 csproj, 不要被插件的默认通配符一起编译 -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

</Project>
